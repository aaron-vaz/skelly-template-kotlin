root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true

# Spotless runs ktlint with these settings
[*.{kt,kts}]
indent_size = 4
max_line_length = 120
ktlint_code_style = ktlint_official
# The order of imports depends on the base package, which is chosen when the project is created
ktlint_standard_import-ordering = disabled
